{
  "schemaVersion": 1,
  "id": "reputation",
  "version": "${version}",

  "name": "Your Reputation",
  "description": "a Jade plugin that displays your reputation on a tooltip with each villager.",
  "authors": ["OctoMiku01"],
  "contributors": ["Aton-Kish"],
  "contact": {
    "homepage": "https://github.com/OctoMiku01/your-reputation",
    "sources": "https://github.com/OctoMiku01/your-reputation",
    "issues": "https://github.com/OctoMiku01/your-reputation/issues"
  },

  "license": "MIT",
  "icon": "assets/reputation/icon.png",

  "environment": "*",
  "entrypoints": {
    "jade": ["atonkish.reputation.ReputationPlugin"]
  },
  "mixins": ["reputation.mixins.json"],

  "depends": {
    "fabricloader": ">=${loader_version}",
    "minecraft": "~${minecraft_version}",
    "java": ">=25",
    "fabric-api": "*",
    "jade": "~${minecraft_version}"
  }
}
